{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/byteowlz/design-system/raw/main/spec/look.schema.json",
  "title": "design-system Look (v1: control recipe)",
  "description": "A versioned Look above schemes: a pinned dark/light scheme pair + Identity + semantic component recipes. Closed enums and small integers only, never raw CSS. Everything a surface renders today must be expressible (compound values included); house-style taste is enforced by a separate lint, not by this schema. See spec/look.md and docs/adr/0004-look-identity-recipes.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "schemes",
    "identity",
    "recipes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schemes": {
      "description": "The Look pins exactly one dark and one light scheme (by scheme id).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dark",
        "light"
      ],
      "properties": {
        "dark": {
          "$ref": "#/$defs/schemeId"
        },
        "light": {
          "$ref": "#/$defs/schemeId"
        }
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "recipes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/control"
        }
      }
    }
  },
  "$defs": {
    "schemeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "role": {
      "description": "One of the 16 closed roles (spec/roles.md). No new portable roles.",
      "enum": [
        "foreground",
        "muted-foreground",
        "background",
        "surface",
        "surface-sunken",
        "primary",
        "secondary",
        "muted",
        "accent",
        "success",
        "warning",
        "danger",
        "info",
        "border",
        "ring",
        "input"
      ]
    },
    "px": {
      "description": "A length in px: an integer or an exact binary fraction (quarter px).",
      "type": "number",
      "multipleOf": 0.25
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "native"
      ],
      "properties": {
        "stack": {
          "description": "Web fallback stack, most preferred first; ends in a generic family.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "native": {
          "description": "The single family name a native surface (GPUI) requests.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fonts",
        "radius"
      ],
      "properties": {
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sans",
            "mono"
          ],
          "properties": {
            "sans": {
              "$ref": "#/$defs/font"
            },
            "mono": {
              "$ref": "#/$defs/font"
            },
            "display": {
              "$ref": "#/$defs/font"
            }
          }
        },
        "radius": {
          "description": "The radius dial in px (spec/radius.md). 0 = sharp.",
          "allOf": [
            {
              "$ref": "#/$defs/px"
            }
          ],
          "minimum": 0,
          "maximum": 32
        },
        "shadows": {
          "description": "The elevation ramp per mode. Required when any elevation references the ramp.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/ramp"
            },
            "light": {
              "$ref": "#/$defs/ramp"
            }
          }
        }
      }
    },
    "ramp": {
      "description": "sm = raised-sm, md = raised-md and the derived hover of raised-sm, lg = the derived hover of raised-md.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sm",
        "md",
        "lg"
      ],
      "properties": {
        "sm": {
          "$ref": "#/$defs/layers"
        },
        "md": {
          "$ref": "#/$defs/layers"
        },
        "lg": {
          "$ref": "#/$defs/layers"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "layer": {
      "description": "One structured shadow layer. Integers only; alpha is a percentage of the colour.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "blur",
        "spread",
        "alpha",
        "color"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -16,
          "maximum": 16
        },
        "y": {
          "type": "integer",
          "minimum": -16,
          "maximum": 64
        },
        "blur": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "spread": {
          "type": "integer",
          "minimum": -32,
          "maximum": 32
        },
        "alpha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "color": {
          "$ref": "#/$defs/shadowColor"
        },
        "inset": {
          "type": "boolean"
        }
      }
    },
    "elevation": {
      "description": "A preset, or an explicit border + shadow. The two parts are independent, so compound values (a border AND a shadow) are valid. Presets: flat = {border 0, shadow none}; hairline = {border 1 foreground/10, shadow none}; raised-sm / raised-md = {border 0, shadow ramp sm / md}.",
      "oneOf": [
        {
          "enum": [
            "flat",
            "hairline",
            "raised-sm",
            "raised-md"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "border",
            "shadow"
          ],
          "properties": {
            "border": {
              "$ref": "#/$defs/border"
            },
            "shadow": {
              "$ref": "#/$defs/shadow"
            }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elevation"
      ],
      "properties": {
        "elevation": {
          "$ref": "#/$defs/elevation"
        },
        "hover": {
          "description": "Optional explicit hover elevation. When absent, hover is derived: a ramp shadow lifts one step, otherwise the surface tints.",
          "$ref": "#/$defs/elevation"
        },
        "focus": {
          "description": "Overrides the control focus for this variant (e.g. a danger-coloured ring).",
          "$ref": "#/$defs/focus"
        }
      }
    },
    "densityPx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "padding_x",
        "gap"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 12,
          "maximum": 64
        },
        "padding_x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "density": {
      "description": "A named table (spec/look.md, defines every tier on both surfaces), or pinned px per surface and size tier when no table fits.",
      "oneOf": [
        {
          "enum": [
            "compact",
            "regular",
            "comfortable"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "web",
            "desktop"
          ],
          "properties": {
            "web": {
              "$ref": "#/$defs/densityTiers"
            },
            "desktop": {
              "$ref": "#/$defs/densityTiers"
            }
          }
        }
      ]
    },
    "focus": {
      "description": "Keyboard focus must stay visible: there is no 'none'. Every value must give >= 3:1 focused-vs-unfocused difference against each adjacent surface in both modes (verified against the pinned schemes by the authoring tool and implementations). Whether a Look may use ring is taste, enforced by the house-Look lint, not here.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "width",
            "offset"
          ],
          "properties": {
            "kind": {
              "const": "ring"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "alpha": {
              "$ref": "#/$defs/alphaByMode"
            },
            "border_to_ring": {
              "description": "The control border also takes the focus colour while focused (per mode when a scheme overrides it).",
              "$ref": "#/$defs/flagByMode"
            },
            "color": {
              "description": "Focus colour role; defaults to ring.",
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "width"
          ],
          "properties": {
            "kind": {
              "const": "outline"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "alpha": {
              "$ref": "#/$defs/alphaByMode"
            },
            "color": {
              "description": "Focus colour role; defaults to ring.",
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "amount"
          ],
          "properties": {
            "kind": {
              "const": "tint"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "width",
            "offset"
          ],
          "properties": {
            "kind": {
              "const": "indicator"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "alpha": {
              "$ref": "#/$defs/alphaByMode"
            },
            "color": {
              "description": "Focus colour role; defaults to ring.",
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "native"
            }
          },
          "description": "The platform's default focus indicator (e.g. a browser outline: auto), pinned where a surface uses it today."
        }
      ]
    },
    "control": {
      "description": "The control recipe (buttons). Variants: primary, secondary, ghost, danger (required) and outline (optional); text controls use ghost.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variants",
        "density",
        "focus"
      ],
      "properties": {
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary",
            "ghost",
            "danger"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/variantSpec"
            },
            "secondary": {
              "$ref": "#/$defs/variantSpec"
            },
            "ghost": {
              "$ref": "#/$defs/variantSpec"
            },
            "danger": {
              "$ref": "#/$defs/variantSpec"
            },
            "outline": {
              "$ref": "#/$defs/variantSpec"
            }
          }
        },
        "density": {
          "$ref": "#/$defs/density"
        },
        "focus": {
          "$ref": "#/$defs/focusSpec"
        }
      }
    },
    "shadowColor": {
      "description": "A role (spec/roles.md) or an absolute neutral. Absolute neutrals exist so existing shadows can be pinned verbatim; they are not portable roles.",
      "oneOf": [
        {
          "$ref": "#/$defs/role"
        },
        {
          "enum": [
            "black",
            "white",
            "transparent"
          ]
        }
      ]
    },
    "borderColor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "alpha"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "alpha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "border": {
      "description": "Border width 0 or 1 px. A 1 px border needs a colour rule; alpha 0 is a transparent (layout-only) border.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width"
          ],
          "properties": {
            "width": {
              "const": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "color"
          ],
          "properties": {
            "width": {
              "const": 1
            },
            "color": {
              "$ref": "#/$defs/borderColor"
            }
          }
        }
      ]
    },
    "shadow": {
      "description": "No shadow, a step of the Look's ramp, or explicit per-mode layers (for pinning an existing surface verbatim).",
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ramp"
          ],
          "properties": {
            "ramp": {
              "enum": [
                "sm",
                "md",
                "lg"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "properties": {
            "dark": {
              "$ref": "#/$defs/layers"
            },
            "light": {
              "$ref": "#/$defs/layers"
            }
          }
        }
      ]
    },
    "densityTiers": {
      "description": "Pinned px per size tier. Tiers follow the toolkit size names: xs, sm, md (the toolkit default) and lg. md is required; a surface pins only the tiers it uses.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "md"
      ],
      "properties": {
        "xs": {
          "$ref": "#/$defs/densityPx"
        },
        "sm": {
          "$ref": "#/$defs/densityPx"
        },
        "md": {
          "$ref": "#/$defs/densityPx"
        },
        "lg": {
          "$ref": "#/$defs/densityPx"
        }
      }
    },
    "alphaByMode": {
      "description": "An integer percentage, or one per mode when the pinned scheme pair differs.",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "properties": {
            "dark": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "light": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      ]
    },
    "flagByMode": {
      "description": "A boolean, or one per mode.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "properties": {
            "dark": {
              "type": "boolean"
            },
            "light": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "focusSpec": {
      "description": "One focus for every surface, or one per surface when they differ today.",
      "oneOf": [
        {
          "$ref": "#/$defs/focus"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "web",
            "desktop"
          ],
          "properties": {
            "web": {
              "$ref": "#/$defs/focus"
            },
            "desktop": {
              "$ref": "#/$defs/focus"
            }
          }
        }
      ]
    },
    "variantSpec": {
      "description": "One variant for every surface, or one per surface when they differ today (the default Look pins surfaces verbatim).",
      "oneOf": [
        {
          "$ref": "#/$defs/variant"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "web",
            "desktop"
          ],
          "properties": {
            "web": {
              "$ref": "#/$defs/variant"
            },
            "desktop": {
              "$ref": "#/$defs/variant"
            }
          }
        }
      ]
    }
  }
}
