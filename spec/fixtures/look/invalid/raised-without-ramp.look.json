{
	"$schema": "../../../look.schema.json",
	"id": "raised-without-ramp",
	"name": "Lumen",
	"version": 1,
	"schemes": {
		"dark": "lumen-dark",
		"light": "lumen-light"
	},
	"identity": {
		"fonts": {
			"sans": {
				"stack": [
					"system-ui",
					"sans-serif"
				],
				"native": "system-ui"
			},
			"mono": {
				"stack": [
					"ui-monospace",
					"monospace"
				],
				"native": "monospace"
			}
		},
		"radius": 10
	},
	"recipes": {
		"control": {
			"variants": {
				"primary": {
					"elevation": "raised-sm"
				},
				"secondary": {
					"elevation": "flat"
				},
				"ghost": {
					"elevation": "flat"
				},
				"danger": {
					"elevation": "flat"
				}
			},
			"density": "regular",
			"focus": {
				"kind": "indicator",
				"width": 2,
				"offset": 3
			}
		}
	}
}
