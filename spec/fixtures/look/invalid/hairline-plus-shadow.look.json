{
	"$schema": "../../../look.schema.json",
	"id": "hairline-plus-shadow",
	"name": "Lumen",
	"version": 1,
	"schemes": {
		"dark": "lumen-dark",
		"light": "lumen-light"
	},
	"identity": {
		"fonts": {
			"sans": {
				"stack": [
					"system-ui",
					"sans-serif"
				],
				"native": "system-ui"
			},
			"mono": {
				"stack": [
					"ui-monospace",
					"monospace"
				],
				"native": "monospace"
			}
		},
		"radius": 10,
