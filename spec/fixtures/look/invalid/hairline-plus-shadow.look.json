						"kind": "raised",
						"level": "sm"
					}
				},
				"secondary": {
					"elevation": {
						"kind": "hairline",
						"color": {
							"role": "foreground",
							"alpha": 9
						},
						"level": "sm"
					}
				},
				"ghost": {
					"elevation": {
						"kind": "flat"
					}
				},
				"danger": {
					"elevation": {
						"kind": "flat"
					}
				}
			},
			"density": "regular",
			"focus": {
				"kind": "indicator",
				"width": 2,
				"offset": 3
			}
		}
	}
