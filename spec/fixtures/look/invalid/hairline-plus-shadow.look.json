					{
						"x": 0,
						"y": 4,
						"blur": 9,
						"spread": -2,
						"alpha": 36,
						"color": "surface-sunken"
					},
					{
						"x": 0,
						"y": 13,
						"blur": 26,
						"spread": -9,
						"alpha": 54,
						"color": "surface-sunken"
