{
	"source": "design-studio artifacts/oqto/chalk-depth/index.html, variant F (Slate); user review 2026-10-03 (grey containers, more contrast after on-screen review of the white Chalk). Status and syntax hues re-derived darker for the grey surfaces.",
	"roles": {
		"background": "#B3BAB5",
		"surface-sunken": "#CBD1CC",
		"surface": "#DFE3E0",
		"foreground": "#121915",
		"muted-foreground": "#414C46",
		"border": "#58635D",
		"input": "#58635D",
		"primary": "#0D5E42",
		"accent": "#BDD4C6",
		"muted": "#D4DAD5",
		"secondary": "#BDD4C6",
		"ring": "#0D5E42"
	},
	"vocabulary": {
		"--primary-foreground": "#FFFFFF",
		"--success-foreground": "#FFFFFF",
		"--warning-foreground": "#FFFFFF",
		"--info-foreground": "#FFFFFF",
		"--destructive-foreground": "#FFFFFF",
		"--card": "#DFE3E0",
		"--popover": "#DFE3E0",
		"--sidebar": "#CBD1CC",
		"--code-bg": "#D1D7D2",
		"--code-inline-bg": "#CBD1CC",
		"--terminal-bg": "#CBD1CC"
	},
	"contrast": {
		"surfaces": ["background", "surface-sunken", "surface", "accent", "muted", "--code-bg"],
		"text": {
			"roles": ["foreground", "muted-foreground"],
			"minimum": 4.5
		},
		"boundary": {
			"roles": ["border", "input", "ring"],
			"minimum": 3
		},
		"pairs": [
			{ "ink": "--primary-foreground", "on": "primary", "minimum": 4.5 },
			{ "ink": "--success-foreground", "on": "success", "minimum": 4.5 },
			{ "ink": "--warning-foreground", "on": "warning", "minimum": 4.5 },
			{ "ink": "--destructive-foreground", "on": "danger", "minimum": 4.5 },
			{ "ink": "--info-foreground", "on": "info", "minimum": 4.5 },
			{ "ink": "--code-success", "on": "--code-bg", "minimum": 4.5 },
			{ "ink": "--code-accent", "on": "--code-bg", "minimum": 4.5 },
			{ "ink": "--code-fg", "on": "--code-bg", "minimum": 4.5 }
		],
		"groups": [
			{
				"inks": ["danger", "warning", "info", "--base08", "--base09", "--base0A", "--base0C", "--base0D", "--base0E", "--base0F", "--base12", "--base13", "--base14", "--base15", "--base16", "--base17"],
				"on": ["background", "surface-sunken", "surface", "accent", "muted", "--code-bg"],
				"minimum": 4.5
			},
			{
				"inks": ["primary", "success"],
				"on": ["surface-sunken", "surface", "accent", "muted", "--code-bg"],
				"minimum": 4.5
			}
		]
	},
	"separation": [
		{ "layer": "surface", "on": "background", "minimum": 1.35 },
		{ "layer": "surface-sunken", "on": "background", "minimum": 1.15 }
	]
}
